{
  "name": "@multica/desktop",
  "productName": "Multica",
  "version": "0.9.0",
  "private": true,
  "description": "Multica Desktop \u2014 native desktop client for the Multica platform.",
  "homepage": "https://multica.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/multica-ai/multica.git",
    "directory": "apps/desktop"
  },
  "author": {
    "name": "Multica",
    "email": "support@multica.ai"
  },
  "license": "SEE LICENSE IN ../../LICENSE",
  "main": "./out/main/index.js",
  "scripts": {
    "bundle-cli": "node scripts/bundle-cli.mjs",
    "bundle-voice-engine": "node scripts/bundle-voice-engine.mjs",
    "brand-dev-electron": "node scripts/brand-dev-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:cloud": "node scripts/dev.mjs --cloud",
    "dev:cloud:claude-login": "node scripts/dev.mjs --cloud --claude-login",
    "dev:staging": "node scripts/dev.mjs --mode staging",
    "build": "pnpm run bundle-cli && pnpm run bundle-voice-engine && node scripts/stage-cua-driver.mjs && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "preview": "electron-vite preview",
    "package": "node scripts/package.mjs",
    "package:all": "node scripts/package.mjs --all-platforms --publish never",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "dev:isolated": "node scripts/dev-isolated.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/modifiers": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist-mono": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@multica/computer-use": "workspace:*",
    "@multica/conversation-client": "workspace:*",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "@multica/core": "workspace:*",
    "@multica/tutti-agent-gui-host": "workspace:*",
    "@multica/ui": "workspace:*",
    "@multica/views": "workspace:*",
    "@pierre/diffs": "1.6.4",
    "@pierre/trees": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tutti-os/browser-node": "workspace:*",
    "electron-updater": "^6.8.3",
    "fix-path": "^5.0.0",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.6.0",
    "shadcn": "catalog:",
    "sonner": "catalog:",
    "tw-animate-css": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:",
    "mobx-react": "catalog:",
    "radix-ui": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@multica/eslint-config": "workspace:*",
    "@multica/tsconfig": "workspace:*",
    "@multica/vitest-setup": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@trycua/cua-driver": "0.40.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^16.0.0",
    "jsdom": "catalog:",
    "sherpa-onnx-node": "2.0.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
