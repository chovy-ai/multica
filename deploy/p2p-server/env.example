# /etc/multica-p2p/env — read by multica-p2p.service. Not committed anywhere.

# Multica API server used to resolve login tokens.
MULTICA_API_URL=https://api.multica.ai

# The server's public IP (Tencent Cloud console → instance → public IP).
# Required: the VM's network interface only carries its private address.
MULTICA_P2P_PUBLIC_IP=

MULTICA_P2P_LISTEN=:8090
MULTICA_P2P_LIBP2P_PORT=4001
MULTICA_P2P_DB=/var/lib/multica-p2p/p2p.db
MULTICA_P2P_KEY=/var/lib/multica-p2p/p2p-server.key
MULTICA_P2P_RELAY_MAX_CIRCUITS_PER_USER=8
